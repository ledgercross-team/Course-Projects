# Copy to .env and fill in. NEVER commit .env. Use a BURNER key for testnet.

# Free RPC key from alchemy.com or infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Burner wallet private key (testnet only, no real funds)
PRIVATE_KEY=0xYOUR_BURNER_PRIVATE_KEY

# Free key from etherscan.io for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
