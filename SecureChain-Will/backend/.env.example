# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/securechain_will

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AES document encryption (32-byte hex key = 64 hex chars)
AES_SECRET_KEY=replace_with_64_char_hex_string

# Pinata (IPFS pinning service)
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Blockchain
# Use BLOCKCHAIN_RPC_URL for the active network. Keep SEPOLIA_RPC_URL only for
# Foundry's sepolia alias and older local configs.
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your_project_id
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_project_id
CONTRACT_ADDRESS=0xDeployedWillRegistryAddress
ADMIN_PRIVATE_KEY=your_admin_wallet_private_key

# Uploads
MAX_FILE_SIZE_MB=20
